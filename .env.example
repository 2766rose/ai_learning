RAG_OPENAI_API_KEY=sk-ws-H.RXHRPXI.5phm.MEUCIHrse1r8x96ArCSH2xxo-4ZTrtUYFgfxDhITllCbrzCaAiEA6VI_cs-vKj8QNRxEIJVFAh_644Pt8E_kwTNaAZnyJdE
RAG_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_OPENAI_MODEL=qwen-plus
RAG_LLM_TEMPERATURE=0.1
