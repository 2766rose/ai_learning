# === LLM 配置（本地 Ollama 或云端 API 二选一）===
# 方式一：本地 Ollama
RAG_OPENAI_BASE_URL=http://localhost:11434/v1
RAG_OPENAI_MODEL=qwen3:8b
RAG_OPENAI_API_KEY=sk-your-key-here

# 方式二：阿里云百炼（云端）
# RAG_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_OPENAI_MODEL=qwen-plus
# RAG_OPENAI_API_KEY=sk-your-dashscope-key

RAG_LLM_TEMPERATURE=0.1
RAG_LLM_MAX_TOKENS=2048

# === Embedding 模型 ===
RAG_EMBED_MODEL_PATH=D:/models/text2vec-base-chinese

# === ChromaDB ===
RAG_CHROMA_PERSIST_DIR=data/chroma_db
RAG_CHROMA_COLLECTION_NAME=knowledge_base
RAG_CHROMA_VECTOR_SPACE=cosine
RAG_TOP_K=5

# === Redis & Celery ===
RAG_REDIS_URL=redis://localhost:6379/0
RAG_CELERY_BROKER_URL=redis://localhost:6379/0
RAG_CELERY_RESULT_BACKEND=redis://localhost:6379/1
RAG_MEMORY_BACKEND=redis
RAG_MEMORY_SESSION_TTL=86400
RAG_MEMORY_MAX_TOKENS=4096

# === 上传 ===
# Docker 部署时改为容器内绝对路径：RAG_UPLOAD_DIR=/data/uploads
RAG_MAX_FILE_SIZE=20971520

# === Langfuse 可观测性（可选）===
# LANGFUSE_PUBLIC_KEY=your-public-key
# LANGFUSE_SECRET_KEY=your-secret-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com