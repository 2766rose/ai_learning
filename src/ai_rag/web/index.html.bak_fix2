<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>星云科技 AI 知识库助手</title>
<style>
  :root {
    --accent: #6366f1;
    --accent-dark: #4f46e5;
    --accent-light: #eef2ff;
    --sidebar-bg: linear-gradient(180deg, #1e1b4b 0%, #111827 100%);
    --main-bg: #f4f5fb;
    --card: #ffffff;
    --text: #1f2937;
    --text-sub: #6b7280;
    --border: #e5e7eb;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", system-ui, sans-serif;
    background: var(--main-bg);
    height: 100vh; overflow: hidden; color: var(--text);
  }
  .app { display: flex; height: 100vh; }

  /* ===== 左侧栏 ===== */
  .sidebar {
    width: 310px; flex-shrink: 0; background: var(--sidebar-bg); color: #e5e7eb;
    display: flex; flex-direction: column; padding: 20px 18px; position: relative; overflow: hidden;
  }
  .sidebar::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(600px 300px at 20% -10%, rgba(99,102,241,.35), transparent 60%);
  }
  .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 26px; position: relative; z-index: 1; }
  .brand .logo {
    width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-size: 22px;
    background: linear-gradient(135deg, #818cf8, #6366f1); box-shadow: 0 6px 16px rgba(99,102,241,.45);
  }
  .brand .name { font-size: 17px; font-weight: 700; color: #fff; letter-spacing: .3px; }
  .brand .sub { font-size: 11px; color: #9ca3af; margin-top: 2px; }
  .section-title { font-size: 12px; color: #9ca3af; letter-spacing: 1px; margin-bottom: 10px; position: relative; z-index: 1; }

  .upload-card {
    border: 1.5px dashed rgba(255,255,255,.22); border-radius: 14px; padding: 22px 14px; text-align: center;
    cursor: pointer; transition: .2s; background: rgba(255,255,255,.04); position: relative; z-index: 1;
  }
  .upload-card:hover, .upload-card.drag { border-color: #818cf8; background: rgba(99,102,241,.15); }
  .upload-card .icon { font-size: 30px; display: block; margin-bottom: 8px; }
  .upload-card .t1 { font-size: 13px; color: #e5e7eb; font-weight: 600; }
  .upload-card .t2 { font-size: 11px; color: #9ca3af; margin-top: 4px; }

  .up-list { margin-top: 14px; overflow-y: auto; flex: 1; position: relative; z-index: 1; }
  .up-list::-webkit-scrollbar { width: 4px; }
  .up-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 4px; }
  .up-item {
    display: flex; align-items: flex-start; gap: 8px; padding: 8px 10px; border-radius: 10px;
    background: rgba(255,255,255,.06); margin-bottom: 6px; font-size: 12px; word-break: break-all;
  }
  .up-item .fi { font-size: 14px; }
  .up-item .body { flex: 1; min-width: 0; }
  .up-item .fn { color: #e5e7eb; }
  .up-item .st { display: block; margin-top: 2px; font-size: 11px; }
  .st.ok { color: #4ade80; } .st.err { color: #f87171; } .st.busy { color: #fbbf24; }
  .spin { display: inline-block; width: 10px; height: 10px; border: 2px solid rgba(251,191,36,.3); border-top-color: #fbbf24; border-radius: 50%; animation: rot .8s linear infinite; vertical-align: -1px; margin-right: 4px; }
  @keyframes rot { to { transform: rotate(360deg); } }

  .side-foot { margin-top: 12px; font-size: 11px; color: #9ca3af; display: flex; flex-direction: column; gap: 6px; position: relative; z-index: 1; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.08); }
  .side-foot .row { display: flex; align-items: center; gap: 6px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
  .dot.on { background: #4ade80; box-shadow: 0 0 6px #4ade80; } .dot.off { background: #f87171; }

  /* ===== 右侧主区 ===== */
  .main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .chat-header {
    padding: 16px 26px; background: rgba(255,255,255,.7); backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px;
  }
  .chat-header .t { font-size: 15px; font-weight: 700; }
  .chat-header .s { font-size: 12px; color: var(--text-sub); }
  .messages { flex: 1; overflow-y: auto; padding: 24px 26px; }
  .messages::-webkit-scrollbar { width: 6px; }
  .messages::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 6px; }
  .msg { display: flex; gap: 10px; margin-bottom: 18px; animation: fadeUp .25s ease; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .avatar {
    width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center; font-size: 16px; flex-shrink: 0;
    box-shadow: 0 3px 8px rgba(0,0,0,.12);
  }
  .msg.user { flex-direction: row-reverse; }
  .msg.user .avatar { background: linear-gradient(135deg, #818cf8, #6366f1); }
  .msg.ai .avatar { background: linear-gradient(135deg, #34d399, #10b981); }
  .bubble {
    max-width: 76%; padding: 11px 15px; border-radius: 14px; line-height: 1.65; font-size: 14px;
    white-space: pre-wrap; word-break: break-word;
  }
  .msg.user .bubble {
    background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff;
    border-top-right-radius: 4px; box-shadow: 0 4px 12px rgba(99,102,241,.3);
  }
  .msg.ai .bubble { background: var(--card); border: 1px solid var(--border); border-top-left-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,.05); }
  .caret { display: inline-block; width: 7px; height: 15px; background: var(--accent); margin-left: 3px; vertical-align: text-bottom; animation: blink .8s infinite; border-radius: 1px; }
  @keyframes blink { 50% { opacity: 0; } }

  .welcome { text-align: center; margin-top: 9vh; animation: fadeUp .4s ease; }
  .welcome .big {
    width: 72px; height: 72px; margin: 0 auto 18px; border-radius: 22px; display: grid; place-items: center; font-size: 36px;
    background: linear-gradient(135deg, #818cf8, #6366f1); box-shadow: 0 14px 30px rgba(99,102,241,.4);
  }
  .welcome h2 { font-size: 22px; margin-bottom: 8px; }
  .welcome p { color: var(--text-sub); font-size: 14px; margin-bottom: 22px; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; max-width: 640px; margin: 0 auto; }
  .chip {
    border: 1px solid var(--border); background: #fff; color: var(--text); font-size: 13px;
    padding: 8px 14px; border-radius: 20px; cursor: pointer; transition: .18s; box-shadow: 0 1px 4px rgba(0,0,0,.05);
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-light); transform: translateY(-1px); }

  .composer-wrap { padding: 14px 26px 20px; background: linear-gradient(180deg, transparent, var(--main-bg) 30%); }
  .composer {
    background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 10px 12px;
    display: flex; align-items: flex-end; gap: 10px; box-shadow: 0 8px 24px rgba(31,41,55,.08);
  }
  .composer:focus-within { border-color: var(--accent); box-shadow: 0 8px 28px rgba(99,102,241,.18); }
  .composer textarea {
    flex: 1; border: none; outline: none; resize: none; font-size: 14px; font-family: inherit; line-height: 1.5;
    max-height: 120px; min-height: 24px; padding: 6px 4px; background: transparent;
  }
  .send {
    border: none; border-radius: 12px; background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff;
    padding: 10px 18px; font-size: 14px; font-weight: 600; cursor: pointer; transition: .18s; white-space: nowrap;
    box-shadow: 0 4px 12px rgba(99,102,241,.35);
  }
  .send:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(99,102,241,.45); }
  .send:disabled { opacity: .55; transform: none; cursor: not-allowed; }
  .clear-btn { border: 1px solid var(--border); background: #fff; color: var(--text-sub); border-radius: 12px; padding: 10px 14px; font-size: 13px; cursor: pointer; transition: .18s; }
  .clear-btn:hover { color: var(--text); border-color: #cbd5e1; }
  .composer .tip { position: absolute; }
</style>
</head>
<body>
<div class="app">
  <!-- 左侧栏 -->
  <aside class="sidebar">
    <div class="brand">
      <div class="logo">🤖</div>
      <div>
        <div class="name">星云 AI 助手</div>
        <div class="sub">企业知识库 · RAG</div>
      </div>
    </div>
    <div class="section-title">📚 知识库</div>
    <div class="upload-card" id="drop">
      <span class="icon">📁</span>
      <div class="t1">上传知识文档</div>
      <div class="t2">点击选择 或 拖拽到此处 · PDF/TXT/DOCX</div>
    </div>
    <input type="file" id="fileInput" multiple accept=".pdf,.txt,.docx,.xlsx,.xls,.md" style="display:none">
    <div class="up-list" id="upList"></div>
    <div class="side-foot">
      <div class="row"><span class="dot" id="healthDot"></span><span id="healthText">连接检测中…</span></div>
      <div class="row">🛠 <span id="toolsText">工具加载中…</span></div>
      <div class="row">⏱ 限流 20 次/分钟 · 语义缓存已开启</div>
    </div>
  </aside>

  <!-- 右侧主区 -->
  <main class="main">
    <div class="chat-header">
      <div class="t">💬 智能问答</div>
      <div class="s">混合检索 + Reranker + Agent</div>
    </div>
    <div class="messages" id="chatBox">
      <div class="welcome" id="welcome">
        <div class="big">🤖</div>
        <h2>你好，我是知识库助手</h2>
        <p>可以问我关于公司制度、报销、假期等问题，试试下面这些：</p>
        <div class="chips" id="chips">
          <button class="chip">公积金缴纳比例是多少？</button>
          <button class="chip">高铁出差的报销标准是什么？</button>
          <button class="chip">年假需要提前几天申请？</button>
          <button class="chip">星云科技新员工的试用期是多长时间？</button>
        </div>
      </div>
    </div>
    <div class="composer-wrap">
      <div class="composer">
        <textarea id="input" rows="1" placeholder="输入你的问题，Enter 发送，Shift+Enter 换行"></textarea>
        <button class="clear-btn" onclick="clearChat()">清空</button>
        <button class="send" id="sendBtn" onclick="sendMessage()">发送</button>
      </div>
    </div>
  </main>
</div>

<script>
const userId = localStorage.getItem('web_user_id') || ('web-' + Math.random().toString(36).slice(2, 10));
localStorage.setItem('web_user_id', userId);

const $ = id => document.getElementById(id);
const chatBox = $('chatBox'), input = $('input'), upList = $('upList');
let sending = false;

/* 快捷问题 */
document.querySelectorAll('.chip').forEach(c => c.addEventListener('click', () => {
  input.value = c.textContent.trim();
  input.focus();
  sendMessage();
}));

/* ---------- 后端状态 ---------- */
fetch('/health').then(r => r.json()).then(() => {
  $('healthDot').className = 'dot on'; $('healthText').textContent = '后端已连接';
}).catch(() => {
  $('healthDot').className = 'dot off'; $('healthText').textContent = '后端未连接';
});
fetch('/api/rag/agent/tools').then(r => r.json()).then(j => {
  if (j && j.total) $('toolsText').textContent = '可用工具 ' + j.total + ' 个';
}).catch(() => { $('toolsText').textContent = '工具信息不可用'; });

/* ---------- 聊天 ---------- */
function scrollBottom() { chatBox.scrollTop = chatBox.scrollHeight; }
function addMsg(role, text) {
  const w = $('welcome'); if (w) w.remove();
  const row = document.createElement('div');
  row.className = 'msg ' + role;
  const av = document.createElement('div'); av.className = 'avatar'; av.textContent = role === 'user' ? '🙂' : '🤖';
  const bubble = document.createElement('div'); bubble.className = 'bubble'; bubble.textContent = text;
  row.appendChild(av); row.appendChild(bubble);
  chatBox.appendChild(row);
  scrollBottom();
  return bubble;
}
async function sendMessage() {
  const text = input.value.trim();
  if (!text || sending) return;
  addMsg('user', text);
  input.value = '';
  const bubble = addMsg('ai', '');
  const caret = document.createElement('span'); caret.className = 'caret';
  bubble.appendChild(caret);
  sending = true; $('sendBtn').disabled = true;
  try {
    const resp = await fetch('/api/rag/chat/stream', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: [{ role: 'user', content: text }], user_id: userId, stream: true })
    });
    if (!resp.ok) {
      let msg = '请求失败（' + resp.status + '）';
      try { const j = await resp.json(); if (j.detail) msg = j.detail; } catch (e) {}
      bubble.textContent = '⚠️ ' + msg;
      return;
    }
    const reader = resp.body.getReader();
    const dec = new TextDecoder();
    let buf = '', full = '', gotAny = false;
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buf += dec.decode(value, { stream: true });
      let idx;
      while ((idx = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, idx).trim(); buf = buf.slice(idx + 1);
        if (!line.startsWith('data: ')) continue;
        const raw = line.slice(6); if (!raw) continue;
        let data; try { data = JSON.parse(raw); } catch (e) { continue; }
        if (data.type === 'chunk') { gotAny = true; full += data.data; bubble.textContent = full; scrollBottom(); }
        else if (data.type === 'error') { gotAny = true; bubble.textContent = full + '\n⚠️ ' + data.message; scrollBottom(); }
        else if (data.type === 'done') { break; }
      }
    }
    if (!full && !gotAny) bubble.textContent = '⚠️ 没有收到回复';
  } catch (e) {
    bubble.textContent = '⚠️ 连接失败：' + e.message;
  } finally {
    sending = false; $('sendBtn').disabled = false;
    scrollBottom();
  }
}
function clearChat() {
  chatBox.innerHTML = '';
  const w = document.createElement('div'); w.className = 'welcome'; w.id = 'welcome';
  w.innerHTML = '<div class="big">🤖</div><h2>你好，我是知识库助手</h2><p>对话已清空，继续提问吧～</p>';
  chatBox.appendChild(w);
}
input.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
});

/* ---------- 上传 ---------- */
const drop = $('drop'), fileInput = $('fileInput');
drop.addEventListener('click', () => fileInput.click());
drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('drag'); });
drop.addEventListener('dragleave', () => drop.classList.remove('drag'));
drop.addEventListener('drop', e => { e.preventDefault(); drop.classList.remove('drag'); uploadFiles(e.dataTransfer.files); });
fileInput.addEventListener('change', () => { uploadFiles(fileInput.files); fileInput.value = ''; });

function addUpItem(name, text, cls) {
  const item = document.createElement('div');
  item.className = 'up-item';
  const fi = document.createElement('span'); fi.className = 'fi'; fi.textContent = '📄';
  const body = document.createElement('div'); body.className = 'body';
  const fn = document.createElement('div'); fn.className = 'fn'; fn.textContent = name;
  const st = document.createElement('span'); st.className = 'st ' + cls; st.textContent = text;
  body.appendChild(fn); body.appendChild(st);
  item.appendChild(fi); item.appendChild(body);
  upList.prepend(item);
  return st;
}
async function uploadFiles(files) {
  for (const f of files) {
    const st = addUpItem(f.name, '上传中…', 'busy');
    st.innerHTML = '<span class="spin"></span>上传中…';
    const fd = new FormData();
    fd.append('file', f);
    try {
      const resp = await fetch('/api/rag/upload', { method: 'POST', body: fd });
      const j = await resp.json().catch(() => ({}));
      if (!resp.ok) { st.innerHTML = '❌ 上传失败：' + (j.detail || resp.status); st.className = 'st err'; continue; }
      st.innerHTML = '<span class="spin"></span>' + (j.message || '后台处理中…');
      pollStatus(j.task_id, st);
    } catch (e) { st.innerHTML = '❌ 上传失败：' + e.message; st.className = 'st err'; }
  }
}
async function pollStatus(taskId, el, tries) {
  tries = tries || 0;
  try {
    const resp = await fetch('/api/rag/upload/' + taskId + '/status');
    const j = await resp.json();
    if (j.status === 'SUCCESS') { el.innerHTML = '✅ 入库完成'; el.className = 'st ok'; }
    else if (j.status === 'FAILURE') { el.innerHTML = '❌ 入库失败：' + (j.error || '未知错误'); el.className = 'st err'; }
    else if (tries < 90) { setTimeout(() => pollStatus(taskId, el, tries + 1), 2000); }
    else { el.innerHTML = '⏳ 仍在处理中，请稍后…'; }
  } catch (e) { el.innerHTML = '⏳ 状态查询失败，稍后自动重试…'; setTimeout(() => pollStatus(taskId, el, tries + 1), 3000); }
}
</script>
</body>
</html>